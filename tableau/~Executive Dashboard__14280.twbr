      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0981331667025920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([profit]) / SUM([sales])' />
      </column>
      <column caption='  Cost' datatype='real' name='[Calculation_0981331669147652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[sales] - [profit]' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_0981331669508102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sales]) / COUNTD([order_id])' />
      </column>
      <column caption=' Return Rate' datatype='real' name='[Calculation_0981331669602311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([return_flag]) / COUNT([order_id])' />
      </column>
      <column caption='Shipping Delay Bucket' datatype='string' name='[Calculation_0981331669671944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delivery_days] &lt;= 1 THEN &quot;Express&quot;&#13;&#10;ELSEIF [delivery_days] &lt;= 3 THEN &quot;Fast&quot;&#13;&#10;ELSEIF [delivery_days] &lt;= 5 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Slow&quot;&#13;&#10;END' />
      </column>
